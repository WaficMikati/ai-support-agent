# Copy to .env and fill in. .env is gitignored.
# agent.py reads this file itself, so there is nothing to export.

# --- Chatwoot
CHATWOOT_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
# Chatwoot: Profile Settings -> Access Token
CHATWOOT_TOKEN=

# --- OpenRouter. Free from openrouter.ai, no card.
OPENROUTER_API_KEY=
# Free and fast: about a second to classify, two to answer. The obvious pick,
# openai/gpt-oss-20b:free, has one provider that took seconds to minutes.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# Any OpenAI-shaped endpoint works. To go back to Groq, which has a far more
# generous free tier, set these two instead of the model above:
#   OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
#   OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: pin the provider endpoint and disable fallbacks.
# OPENROUTER_PROVIDER=Groq,Fireworks

# Optional: refuse endpoints that do not advertise structured output support.
# Off by default because it cuts the free catalogue from fourteen models to
# four without actually guaranteeing the schema is enforced.
# MODEL_REQUIRE_SCHEMA=true

# --- Stripe. Restricted key from a sandbox: "Charges and refunds" write,
# "Customers" read, everything else None. The agent refuses to start unless
# this is a test key.
STRIPE_API_KEY=

# --- Optional. Only used by scripts/e2e_check.py to create test customers and
# charges, which the restricted key above deliberately cannot do. The agent
# itself never reads this.
STRIPE_SETUP_KEY=

# --- The demo page. Injected into demo/index.html when it is served, so the
# widget token is not typed into the HTML. Falls back to widget_token in
# deploy/admin.local.txt, which the Chatwoot setup writes there anyway.
CHATWOOT_WIDGET_TOKEN=

# --- Help centre. The portal slug whose articles are the agent's facts.
# Seed a mock one with: uv run python scripts/seed_helpcenter.py
# Leave blank to answer from KNOWLEDGE_FILE alone.
HELP_CENTRE_PORTAL=acme-coffee-help

# --- Behaviour
# 0 keeps classification repeatable and stops small models dropping stray
# tokens into replies. Raise it only if you want varied wording.
MODEL_TEMPERATURE=0
KNOWLEDGE_FILE=knowledge.md
POLL_INTERVAL_SECONDS=5
