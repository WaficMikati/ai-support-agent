# Copy to .env and fill in. .env is gitignored.
# agent.py reads this file itself, so there is nothing to export.

# --- Chatwoot
CHATWOOT_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
# Chatwoot: Profile Settings -> Access Token
CHATWOOT_TOKEN=

# --- Groq. Free from console.groq.com, no card.
GROQ_API_KEY=
# Only openai/gpt-oss-20b and openai/gpt-oss-120b support strict JSON schema.
GROQ_MODEL=openai/gpt-oss-20b

# --- Stripe. Restricted key from a sandbox: "Charges and refunds" write,
# "Customers" read, everything else None. The agent refuses to start unless
# this is a test key.
STRIPE_API_KEY=

# --- Optional. Only used by scripts/e2e_check.py to create test customers and
# charges, which the restricted key above deliberately cannot do. The agent
# itself never reads this.
STRIPE_SETUP_KEY=

# --- Behaviour
KNOWLEDGE_FILE=knowledge.md
POLL_INTERVAL_SECONDS=5
